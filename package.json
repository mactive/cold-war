{
  "name": "coldwar-frontline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.js",
    "simulate": "node scripts/simulate.mjs",
    "import": "node scripts/import-cards.mjs",
    "presimulate": "npm run import",
    "pretest": "npm run import",
    "prebuild": "npm run import",
    "predev": "npm run import",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/browser-combat.mjs && node scripts/browser-drag.mjs",
    "format": "prettier --write src scripts tests vite.config.js index.html"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.7"
  }
}
