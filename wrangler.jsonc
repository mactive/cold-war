{
  "name": "cold-war",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "main": "server/index.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cold-war-cms",
      "database_id": "242eb64a-1b52-4f41-ae64-2b511f38f8b0",
      "migrations_dir": "migrations"
    }
  ]
}
